# Server Configuration
PORT=4001
NODE_ENV=development

# Database Configuration (MySQL / TiDB Cloud)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trivgoo_development
DB_SSL=false

# Session & Security
SESSION_NAME=trivgoo_sid
SESSION_SECRET=your_super_secret_session_key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL
BASE_URL=http://localhost:4001
API_URL=http://localhost:4001/api/v1
FRONTEND_URL=http://localhost:3000

# AI Provider Configuration (groq / gemini)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateway Configuration (Sandbox)
XENDIT_SECRET_KEY=xnd_development_your_key_here
XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_token_here
DOKU_CLIENT_ID=your_doku_client_id_here
DOKU_SECRET_KEY=your_doku_secret_key_here
DOKU_BASE_URL=https://api-sandbox.doku.com

# Email SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
